{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Herbox Design Tokens",
  "version": "1.0.0",
  "description": "Canonical design tokens for Herbox (Herbivore's Box), covering color, typography, spacing, radius, and elevation.",
  "color": {
    "brand": {
      "coral-red": {
        "value": "#ED5855",
        "type": "color",
        "description": "Primary high-energy accent for CTAs, prices, and appetite appeal. Manual ref #CA5037."
      },
      "forest-green": {
        "value": "#265A32",
        "type": "color",
        "description": "Signature brand color representing fresh plant-based harvest and earthiness."
      },
      "ivory-base": {
        "value": "#F7F4E2",
        "type": "color",
        "description": "Warm, natural organic background canvas for web, app, and slide decks. Manual ref #F2F2F2."
      },
      "leaf-sage": {
        "value": "#9EBF81",
        "type": "color",
        "description": "Secondary botanical accent for healthy badges, nutrition pills, and soft illustrations."
      },
      "terracotta": {
        "value": "#E17A65",
        "type": "color",
        "description": "Warm organic secondary tone for supergraphics and seasonal highlights."
      }
    },
    "neutral": {
      "white": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "Clean surface for cards, dialogs, and text on dark backgrounds."
      },
      "charcoal": {
        "value": "#1C1C1C",
        "type": "color",
        "description": "Deep legible charcoal for extended body text and high-contrast headlines."
      },
      "border-light": {
        "value": "#ECE8D7",
        "type": "color",
        "description": "Subtle border line for cards and dividers over the ivory background."
      }
    },
    "semantic": {
      "background": {
        "value": "{color.brand.ivory-base}",
        "type": "color"
      },
      "surface": {
        "value": "{color.neutral.white}",
        "type": "color"
      },
      "text-primary": {
        "value": "{color.brand.forest-green}",
        "type": "color"
      },
      "text-secondary": {
        "value": "{color.neutral.charcoal}",
        "type": "color"
      },
      "text-inverted": {
        "value": "{color.brand.ivory-base}",
        "type": "color"
      },
      "action-primary": {
        "value": "{color.brand.coral-red}",
        "type": "color"
      },
      "action-secondary": {
        "value": "{color.brand.forest-green}",
        "type": "color"
      },
      "badge-success": {
        "value": "{color.brand.leaf-sage}",
        "type": "color"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": {
        "value": "'Shrimp', 'Fredoka', 'Outfit', system-ui, -apple-system, sans-serif",
        "type": "fontFamily",
        "description": "Bold, rounded, friendly display font for headers, hero titles, and slide titles."
      },
      "body": {
        "value": "'Coves', 'Nunito', 'Poppins', system-ui, -apple-system, sans-serif",
        "type": "fontFamily",
        "description": "Clean, highly legible humanist/geometric sans-serif for body copy, lists, and specs."
      }
    },
    "fontSize": {
      "xs": { "value": "11px", "type": "dimension" },
      "sm": { "value": "13px", "type": "dimension" },
      "base": { "value": "15px", "type": "dimension" },
      "md": { "value": "18px", "type": "dimension" },
      "lg": { "value": "22px", "type": "dimension" },
      "xl": { "value": "28px", "type": "dimension" },
      "2xl": { "value": "36px", "type": "dimension" },
      "3xl": { "value": "48px", "type": "dimension" }
    },
    "fontWeight": {
      "light": { "value": "300", "type": "fontWeight" },
      "regular": { "value": "400", "type": "fontWeight" },
      "medium": { "value": "500", "type": "fontWeight" },
      "semibold": { "value": "600", "type": "fontWeight" },
      "bold": { "value": "700", "type": "fontWeight" },
      "extrabold": { "value": "800", "type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "value": "1.15", "type": "number" },
      "snug": { "value": "1.25", "type": "number" },
      "normal": { "value": "1.5", "type": "number" },
      "relaxed": { "value": "1.65", "type": "number" }
    }
  },
  "spacing": {
    "1": { "value": "4px", "type": "dimension" },
    "2": { "value": "8px", "type": "dimension" },
    "3": { "value": "12px", "type": "dimension" },
    "4": { "value": "16px", "type": "dimension" },
    "5": { "value": "20px", "type": "dimension" },
    "6": { "value": "24px", "type": "dimension" },
    "8": { "value": "32px", "type": "dimension" },
    "10": { "value": "40px", "type": "dimension" },
    "12": { "value": "48px", "type": "dimension" },
    "16": { "value": "64px", "type": "dimension" }
  },
  "borderRadius": {
    "none": { "value": "0px", "type": "dimension" },
    "sm": { "value": "6px", "type": "dimension" },
    "md": { "value": "12px", "type": "dimension" },
    "lg": { "value": "20px", "type": "dimension" },
    "xl": { "value": "32px", "type": "dimension" },
    "full": { "value": "9999px", "type": "dimension" }
  },
  "boxShadow": {
    "none": { "value": "none", "type": "boxShadow" },
    "subtle": {
      "value": "0px 2px 8px rgba(38, 90, 50, 0.06)",
      "type": "boxShadow",
      "description": "Default card elevation on warm ivory base"
    },
    "raised": {
      "value": "0px 8px 20px rgba(38, 90, 50, 0.10)",
      "type": "boxShadow",
      "description": "Card hover and elevated container"
    },
    "floating": {
      "value": "0px 16px 36px rgba(28, 28, 28, 0.14)",
      "type": "boxShadow",
      "description": "Modal dialogs, popovers, and sticky cart bar"
    }
  }
}
